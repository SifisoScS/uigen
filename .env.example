# ── AI ─────────────────────────────────────────────────────────────────────────
# Required for real Claude responses. Omit to run with the built-in mock model.
ANTHROPIC_API_KEY=

# ── Auth ───────────────────────────────────────────────────────────────────────
# Secret used to sign JWTs. REQUIRED in production — must be at least 32 random chars.
# Generate one with: openssl rand -base64 32
JWT_SECRET=

# ── App ────────────────────────────────────────────────────────────────────────
# Set to "production" to enable secure (HTTPS-only) session cookies.
NODE_ENV=development
