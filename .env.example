# ── Database ────────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, or any Postgres provider).
# Local dev: use a local Postgres instance or a Neon free-tier branch.
# Generate Neon connection string at: https://neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── AI ──────────────────────────────────────────────────────────────────────────
# Required for real Claude responses. Omit to run with the built-in mock model.
ANTHROPIC_API_KEY=

# ── Auth ────────────────────────────────────────────────────────────────────────
# Secret used to sign JWTs. REQUIRED in production — must be at least 32 random chars.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=

# ── App ─────────────────────────────────────────────────────────────────────────
# Set to "production" to enable secure (HTTPS-only) session cookies.
NODE_ENV=development
