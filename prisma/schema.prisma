generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  projects  Project[]
}

model Project {
  id                    String            @id @default(cuid())
  name                  String
  userId                String?
  public                Boolean           @default(false)
  messages              String            @default("[]")
  data                  String            @default("{}")
  forkedFromSnapshotId  String?
  remixedFromArtifactId String?
  agentName             String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  approvedAt            DateTime?
  approvedBy            String?
  status                String            @default("DRAFT")
  mergedAt              DateTime?
  mergedFromVariantId   String?
  conflictResolvedAt    DateTime?
  mutationAppliedAt     DateTime?
  forkedFromSnapshot    ProjectSnapshot?  @relation("ForkSource", fields: [forkedFromSnapshotId], references: [id])
  user                  User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots             ProjectSnapshot[]

  @@index([userId])
}

model ProjectSnapshot {
  id                   String            @id @default(cuid())
  projectId            String
  label                String
  name                 String?
  tags                 String            @default("[]")
  pinned               Boolean           @default(false)
  branchName           String?
  isVersionTag         Boolean           @default(false)
  mergedFromSnapshotId String?
  messages             String            @default("[]")
  data                 String            @default("{}")
  createdAt            DateTime          @default(now())
  forks                Project[]         @relation("ForkSource")
  mergedFrom           ProjectSnapshot?  @relation("MergeSource", fields: [mergedFromSnapshotId], references: [id])
  mergedInto           ProjectSnapshot[] @relation("MergeSource")
  project              Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model BranchPolicy {
  id         String   @id @default(cuid())
  projectId  String
  branchName String
  policyType String
  rules      Json?
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([projectId, branchName])
  @@index([projectId])
}

model GovernanceEvent {
  id        String   @id @default(cuid())
  projectId String
  type      String
  actor     String?
  details   Json?
  timestamp DateTime @default(now())

  @@index([projectId, timestamp])
}

model DatasetSnapshot {
  id            String   @id @default(cuid())
  name          String
  description   String?
  format        String?
  rowCount      Int?
  columnSummary Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AgentInvocation {
  id           String   @id @default(cuid())
  agentName    String
  prompt       String
  critiqueJson Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
}

model WorkflowRun {
  id            String         @id @default(cuid())
  name          String
  description   String?
  workflowId    String?
  inputData     Json?
  outputSummary String?
  status        String         @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  steps         WorkflowStep[]

  @@index([status])
}

model WorkflowStep {
  id           String      @id @default(cuid())
  runId        String
  stepIndex    Int
  stepType     String      // EVALUATE | CRITIQUE | SCORE | GENERATE_VARIANTS
  inputData    Json?
  outputData   Json?
  status       String      @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED
  durationMs   Int?
  errorMessage String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  run          WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([runId, stepIndex])
}

model WorkflowDefinition {
  id          String   @id @default(cuid())
  name        String
  description String?
  stepsJson   Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ArtifactRelation {
  id           String   @id @default(cuid())
  parentType   String
  parentId     String
  childType    String
  childId      String
  relationType String
  createdAt    DateTime @default(now())

  @@unique([parentType, parentId, childType, childId])
  @@index([childType, childId])
  @@index([parentType, parentId])
}

model AgentReputation {
  id            String   @id @default(cuid())
  agentName     String   @unique
  score         Float    @default(0.7)
  approvedCount Int      @default(0)
  rejectedCount Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@index([score])
}

model EvaluationRun {
  id                 String   @id @default(cuid())
  artifactId         String
  status             String   @default("PENDING") // PENDING | PASSED | FAILED
  metrics            Json
  regressionDetected Boolean  @default(false)
  baselineArtifactId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([artifactId])
  @@index([status])
  @@index([artifactId, createdAt])
}

model PublicArtifact {
  id               String    @id @default(cuid())
  projectId        String
  branchName       String
  version          String
  name             String
  description      String?
  manifest         Json
  filesData        String
  previewImage     String?
  authorId         String?
  remixCount       Int       @default(0)
  lastRemixedAt    DateTime?
  parentArtifactId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  componentTree    Json?
  semanticSummary  String?
  styleSignature   Json?

  @@index([projectId])
  @@index([createdAt])
  @@index([remixCount])
  @@index([parentArtifactId])
}
